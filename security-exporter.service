[Unit]
Description=Prometheus security-exporter
Wants=basic.target
After=basic.target network.target

[Service]
EnvironmentFile=-/etc/default/security-exporter
ExecStart=/opt/obmondo/bin/security-exporter -config=/etc/security-exporter/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=always
User=root

[Install]
WantedBy=multi-user.target
